  {
   "id": "el70",
   "type": "text",
   "x": 0,
   "y": 800,
   "width": 1568.0000000000002,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1070,
   "version": 1,
   "versionNonce": 5070,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "Trust boundaries: the tenant endpoint's answers are data and reach the judge only as text to grade. The judge sees answers and rules, so host it where that data may go.\nTenant rules are tenant input: the app stores them as fields and checks them with validate_policy_data. It parses no tenant YAML. The app builds the judge object itself; keys stay in its own settings.",
   "originalText": "Trust boundaries: the tenant endpoint's answers are data and reach the judge only as text to grade. The judge sees answers and rules, so host it where that data may go.\nTenant rules are tenant input: the app stores them as fields and checks them with validate_policy_data. It parses no tenant YAML. The app builds the judge object itself; keys stay in its own settings.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
